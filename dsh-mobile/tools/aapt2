#!/bin/bash
# aarch64 Linux host aapt2 workaround: Google only releases x86_64 binaries,
# use box64 to run the x86_64 aapt2 from the SDK.
# SDK location: prefer $ANDROID_HOME, then sdk.dir from local.properties in the project.
SDK="${ANDROID_HOME:-$(sed -n 's/^sdk.dir=//p' "$(dirname "$0")/../local.properties" 2>/dev/null)}"
if [ -z "$SDK" ]; then
  echo "tools/aapt2: SDK not found (set ANDROID_HOME or sdk.dir in local.properties)" >&2
  exit 1
fi
AAPT2="$(ls -d "$SDK"/build-tools/*/aapt2 2>/dev/null | sort -V | tail -1)"
if [ -z "$AAPT2" ]; then
  echo "tools/aapt2: no aapt2 found under $SDK/build-tools" >&2
  exit 1
fi
exec box64 "$AAPT2" "$@"
